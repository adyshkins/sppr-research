    "/api/research/r08/jobs/{id}/episodes/{index}/files/{name}": {
      "get": {
        "summary": "Download hash-verified primary output",
        "tags": [
          "DEV-R08"
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Host or Origin rejected"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
