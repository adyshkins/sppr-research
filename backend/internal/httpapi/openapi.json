    "/api/research/r08/jobs": {
      "get": {
        "summary": "List new local R08 runs",
        "tags": [
          "DEV-R08"
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Host or Origin rejected"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "State or binary version conflict"
          },
          "422": {
            "description": "Invalid request"
          },
          "429": {
            "description": "One job at a time"
          },
          "503": {
            "description": "R08 binary not connected"
          },
          "507": {
            "description": "Local storage quota reached"
          }
        }
      }
    },
    "/api/research/r08/experiments": {
      "post": {
        "summary": "Start archived R08 configurations, never F10/E11",
        "tags": [
          "DEV-R08"
        ],
        "responses": {
          "202": {
            "description": "Success"
          },
          "403": {
            "description": "Host or Origin rejected"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "State or binary version conflict"
          },
          "422": {
            "description": "Invalid request"
          },
          "429": {
            "description": "One job at a time"
          },
          "503": {
