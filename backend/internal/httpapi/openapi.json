          "200": {
            "description": "API specification"
          },
          "403": {
            "description": "Host or Origin rejected"
          },
          "500": {
            "description": "Storage or integrity error"
          }
        }
      }
    },
    "/api/research/profile/validate": {
      "post": {
        "summary": "Validate raw E11 CSV",
        "responses": {
          "200": {
            "description": "Validate raw E11 CSV"
          },
          "403": {
            "description": "Host or Origin rejected"
          },
          "500": {
            "description": "Storage or integrity error"
          },
          "413": {
            "description": "Payload too large"
          },
          "415": {
            "description": "Content type invalid"
          },
          "422": {
            "description": "Bundle or seed invalid"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "text/csv": {
              "schema": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "/api/research/runs": {
      "get": {
        "summary": "List imports",
        "responses": {
          "200": {
            "description": "List imports"
          },
          "403": {
            "description": "Host or Origin rejected"
          },
          "500": {
            "description": "Storage or integrity error"
          }
        }
      },
      "post": {
        "summary": "Import a complete summary bundle",
        "responses": {
          "201": {
            "description": "Import a complete summary bundle"
          },
          "403": {
            "description": "Host or Origin rejected"
          },
          "500": {
            "description": "Storage or integrity error"
          },
          "413": {
            "description": "Payload too large"
          },
          "415": {
            "description": "Content type invalid"
          },
          "422": {
            "description": "Bundle or seed invalid"
          },
          "507": {
            "description": "Storage quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Bundle"
              }
            }
          }
        }
      }
    },
    "/api/research/runs/{id}": {
      "get": {
        "summary": "Manifest, structural checks and means",
        "responses": {
          "200": {
            "description": "Manifest, structural checks and means"
          },
          "403": {
            "description": "Host or Origin rejected"
          },
          "500": {
            "description": "Storage or integrity error"
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ]
      }
    },
    "/api/research/runs/{id}/download": {
      "get": {
        "summary": "Download original bytes",
        "responses": {
          "200": {
            "description": "Download original bytes"
          },
          "403": {
            "description": "Host or Origin rejected"
          },
          "500": {
            "description": "Storage or integrity error"
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ]
      }
    },
    "/api/research/runs/{id}/analysis": {
      "post": {
        "summary": "New paired bootstrap analysis",
        "responses": {
          "200": {
            "description": "New paired bootstrap analysis"
          },
          "403": {
            "description": "Host or Origin rejected"
          },
          "500": {
            "description": "Storage or integrity error"
          },
          "404": {
            "description": "Not found"
          },
          "413": {
            "description": "Payload too large"
          },
          "415": {
            "description": "Content type invalid"
          },
          "422": {
            "description": "Bundle or seed invalid"
          },
          "429": {
            "description": "Analysis busy"
          },
          "408": {
            "description": "Analysis cancelled"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "seed"
                ],
                "properties": {
                  "seed": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/research/experiments": {
      "post": {
        "summary": "Blocked: engine missing",
