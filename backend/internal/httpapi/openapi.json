          },
          "507": {
            "description": "Local storage quota reached"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/R08Request"
              }
            }
          }
        }
      }
    },
    "/api/research/r08/jobs/{id}": {
