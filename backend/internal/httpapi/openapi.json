{
  "openapi": "3.1.0",
  "info": {
    "title": "SPPR Research Workbench",
    "version": "0.3.0-dev",
    "description": "Local research workbench: preserved DEV-R08 engine 0.8, asynchronous execution and replay, plus structural import/analysis of F10/E11 summaries. Execution of F10/E11 is not implemented by the available archive. Loopback only."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18081"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Service health"
          },
          "403": {
            "description": "Host or Origin rejected"
          },
          "500": {
            "description": "Storage or integrity error"
          }
        }
      }
    },
    "/api/research/spec": {
      "get": {
        "summary": "Article design and policy descriptions",
