          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 239
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "experiment_config.json",
                "controller.jsonl.gz",
                "physical.jsonl.gz",
                "summary.json",
                "COMPLETED.json"
              ]
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Bundle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "purpose",
          "series",
          "manifest",
          "episodes"
        ],
        "properties": {
          "schema": {
            "const": "sppr-results-v1"
          },
          "purpose": {
            "enum": [
              "research_import",
              "software_test"
            ]
          },
          "series": {
            "enum": [
              "F10",
              "E11"
            ]
          },
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "episodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Episode"
            },
            "minItems": 672,
            "maxItems": 840
          }
        },
        "description": "Complete Cartesian design: 840 F10 or 672 E11 episodes. This is a NEW interchange format, not a claim about the native engine archive format."
      },
      "Manifest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine_version",
          "source_sha256",
          "config_sha256",
          "input_sha256",
          "plan_sha256"
        ],
        "properties": {
          "engine_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "plan_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "notes": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "Episode": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group",
          "replication",
          "policy",
          "horizon_days",
          "environment_sha256",
          "forecast_steps",
          "total_loss",
          "kpi_loss",
          "action_cost"
        ],
        "properties": {
          "group": {
            "enum": [
              "normal",
              "S",
              "C",
              "D",
              "DS",
              "W1",
              "W2",
              "W3",
              "W4"
            ]
          },
          "replication": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "policy": {
            "enum": [
              "B00",
              "H0",
              "EM0",
              "F",
              "S",
              "A",
              "G"
            ]
          },
          "horizon_days": {
            "const": 60
          },
          "environment_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "forecast_steps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "total_loss": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "kpi_loss": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "action_cost": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          }
        }
      },
      "R08Request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "repeat",
          "arms"
        ],
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "normal",
              "S",
              "C",
              "D",
              "DS"
            ]
          },
          "repeat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "arms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "B0",
                "H",
                "EM",
                "ET"
              ]
            },
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true
          }
        }
      },
      "R08Job": {
        "type": "object",
        "required": [
          "id",
          "series",
          "status",
          "episodes",
          "plan_sha256",
          "engine_sha256",
          "replay_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "series": {
            "const": "DEV-R08"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "complete",
              "cancelled",
              "failed",
              "interrupted"
            ]
          },
          "request": {
            "$ref": "#/components/schemas/R08Request"
          },
          "episodes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "plan_sha256": {
            "type": "string"
          },
          "engine_sha256": {
            "type": "string"
          },
          "replay_status": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
